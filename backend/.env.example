# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# Get this from your Supabase project → Settings → Database → Connection string
DATABASE_URL="postgresql://USER:PASSWORD@host:5432/postgres?schema=public"

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="your_access_secret_here"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_SECRET="your_refresh_secret_here"
JWT_REFRESH_EXPIRY="7d"
JWT_REMEMBER_ME_EXPIRY="30d"
JWT_VERIFICATION_SECRET="your_verification_secret_here"
JWT_VERIFICATION_EXPIRY="1h"
JWT_RESET_PASSWORD_SECRET="your_reset_secret_here"
JWT_RESET_PASSWORD_EXPIRY="15m"

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN="frontend-url"

# Mailtrap SMTP (MAIL_USER/MAIL_PASS are also supported)
MAIL_HOST="sandbox.smtp.mailtrap.io"
MAIL_PORT=2525
MAILTRAP_USER="your_mailtrap_username"
MAILTRAP_PASS="your_mailtrap_password"
FRONTEND_URL="http://localhost:5173"

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your_google_client_id_here"
