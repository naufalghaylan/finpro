// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  SUPER_ADMIN
  STORE_ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  WAITING_CONFIRMATION
  PROCESSING
  SHIPPED
  CONFIRMED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  NOMINAL
  BUY_ONE_GET_ONE
}

enum VoucherApplicableTo {
  ALL_PRODUCTS
  SPECIFIC_PRODUCT
  SHIPPING
}

enum VoucherSource {
  REFERRAL
  MIN_PURCHASE_REWARD
  PROMO
  FREE_SHIPPING_REWARD
}

enum StockJournalType {
  IN
  OUT
  ADJUSTMENT
  ORDER
  CANCEL_RETURN
  MUTATION_IN
  MUTATION_OUT
}

enum MutationStatus {
  PENDING
  APPROVED
  IN_TRANSIT
  COMPLETED
  REJECTED
}

enum PaymentMethod {
  MANUAL_TRANSFER
  PAYMENT_GATEWAY
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id             Int      @id @default(autoincrement())
  name           String
  username       String?  @unique
  email          String   @unique
  password       String?
  phone          String?
  profilePicture String?
  role           Role     @default(CUSTOMER)
  emailVerified  Boolean  @default(false)
  authProvider   String?  @default("CREDENTIALS")
  authProviderId String?
  storeId        Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  store              Store?          @relation("StoreAdmin", fields: [storeId], references: [id])
  addresses          UserAddress[]
  orders             Order[]
  cart               Cart?
  vouchers           Voucher[]
  referralCode       ReferralCode?   @relation("ReferralCodeOwner")
  referralUsages     ReferralUsage?  @relation("ReferralUsageUser")
  stockJournals      StockJournal[]
  requestedMutations StockMutation[] @relation("MutationRequester")
  approvedMutations  StockMutation[] @relation("MutationApprover")
  refreshTokens      RefreshToken[]

  @@map("users")
}

model Store {
  id            Int      @id @default(autoincrement())
  name          String
  slug          String   @unique
  description   String?
  image         String?
  latitude      Float
  longitude     Float
  address       String
  city          String
  cityId        String? // untuk integrasi API pengiriman (RajaOngkir)
  province      String
  provinceId    String? // untuk integrasi API pengiriman (RajaOngkir)
  postalCode    String?
  phone         String?
  serviceRadius Float    @default(50) // dalam KM
  status        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  admins               User[]          @relation("StoreAdmin")
  stocks               Stock[]
  orders               Order[]
  carts                Cart[]
  discounts            Discount[]
  sourceMutations      StockMutation[] @relation("MutationSource")
  destinationMutations StockMutation[] @relation("MutationDestination")

  @@map("stores")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  icon        String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@map("categories")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String   @unique // tidak boleh ada produk dengan nama yang sama
  slug        String   @unique
  description String?
  categoryId  Int
  basePrice   Float
  weight      Float    @default(0) // dalam gram, untuk kalkulasi ongkir
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category       Category       @relation(fields: [categoryId], references: [id])
  images         ProductImage[]
  stocks         Stock[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  discounts      Discount[]
  vouchers       Voucher[]
  stockMutations StockMutation[]

  @@index([categoryId])
  @@map("products")
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  imageUrl  String
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  storeId   Int? // cart terikat ke toko terdekat user
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store?     @relation(fields: [storeId], references: [id])
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  productId Int
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

model Stock {
  id        Int      @id @default(autoincrement())
  productId Int
  storeId   Int
  quantity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product  Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  store    Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  journals StockJournal[]

  @@unique([productId, storeId])
  @@index([storeId])
  @@map("stocks")
}

// Jurnal perubahan stok — setiap perubahan stok HARUS melalui jurnal
model StockJournal {
  id             Int              @id @default(autoincrement())
  stockId        Int
  orderId        Int? // nullable, hanya diisi jika terkait order
  quantityChange Int // positif = penambahan, negatif = pengurangan
  quantityBefore Int
  quantityAfter  Int
  type           StockJournalType
  description    String?
  createdBy      Int // user (admin) yang membuat perubahan
  createdAt      DateTime         @default(now())

  stock   Stock  @relation(fields: [stockId], references: [id], onDelete: Cascade)
  order   Order? @relation(fields: [orderId], references: [id])
  creator User   @relation(fields: [createdBy], references: [id])

  @@index([stockId])
  @@index([orderId])
  @@index([createdAt])
  @@map("stock_journals")
}

// Mutasi stok antar gudang/toko
model StockMutation {
  id                 Int            @id @default(autoincrement())
  sourceStoreId      Int
  destinationStoreId Int
  productId          Int
  quantity           Int
  status             MutationStatus @default(PENDING)
  requestedBy        Int
  approvedBy         Int?
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  sourceStore      Store   @relation("MutationSource", fields: [sourceStoreId], references: [id])
  destinationStore Store   @relation("MutationDestination", fields: [destinationStoreId], references: [id])
  product          Product @relation(fields: [productId], references: [id])
  requester        User    @relation("MutationRequester", fields: [requestedBy], references: [id])
  approver         User?   @relation("MutationApprover", fields: [approvedBy], references: [id])

  @@index([sourceStoreId])
  @@index([destinationStoreId])
  @@index([productId])
  @@map("stock_mutations")
}

model UserAddress {
  id            Int      @id @default(autoincrement())
  userId        Int
  recipientName String
  phone         String
  address       String
  city          String
  cityId        String? // untuk integrasi API pengiriman (RajaOngkir)
  province      String
  provinceId    String? // untuk integrasi API pengiriman (RajaOngkir)
  district      String? // kecamatan
  postalCode    String?
  latitude      Float?
  longitude     Float?
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("user_addresses")
}

model Order {
  id                   Int           @id @default(autoincrement())
  order_number         String        @unique // nomor order yang mudah dibaca, untuk pencarian
  user_id              Int
  store_id             Int
  address_id           Int // alamat pengiriman yang dipilih saat checkout
  status               OrderStatus   @default(PENDING_PAYMENT)
  total_product_amount Float         @default(0) // subtotal produk sebelum diskon & ongkir
  total_amount         Float // total akhir yang harus dibayar 
  shipping_cost        Float         @default(0)
  discount_amount      Float         @default(0) // orderitem diskon dipindahkan ke order
  shipping_method      String? // nama kurir (JNE, TIKI, dll)
  shipping_service     String? // tipe layanan (REG, YES, dll)
  voucher_id           Int?
  payment_method       PaymentMethod @default(MANUAL_TRANSFER)
  payment_proof        String?
  payment_gateway_id   String? // referensi transaksi payment gateway
  payment_deadline     DateTime? // batas waktu upload bukti bayar (~1 jam)
  shipped_at           DateTime? // waktu pesanan dikirim (untuk hitung auto-confirm)
  confirmed_at         DateTime? // waktu pesanan dikonfirmasi user
  cancelled_at         DateTime?
  cancel_reason        String?
  notes                String?
  created_at           DateTime      @default(now())
  updated_at           DateTime      @updatedAt

  user           User           @relation(fields: [user_id], references: [id])
  store          Store          @relation(fields: [store_id], references: [id])
  address        UserAddress    @relation(fields: [address_id], references: [id])
  voucher        Voucher?       @relation(fields: [voucher_id], references: [id])
  items          OrderItem[]
  stock_journals StockJournal[]

  @@index([user_id])
  @@index([store_id])
  @@index([order_number])
  @@index([created_at])
  @@map("orders")
}

model OrderItem {
  id                   Int      @id @default(autoincrement())
  order_id             Int
  product_id           Int
  quantity             Int
  price_at_time        Float // harga produk saat pemesanan
  subtotal             Float    // dipindah ke OrderItem sebagai subtotal
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  order   Order   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id])

  @@index([order_id])
  @@index([product_id])
  @@map("order_items")
}

// Diskon yang dikelola per toko — setiap toko bisa atur diskon masing-masing
model Discount {
  id            Int          @id @default(autoincrement())
  storeId       Int // diskon dikelola per toko
  productId     Int? // nullable: bisa diskon per produk atau tanpa produk tertentu
  name          String
  description   String?
  discountType  DiscountType
  discountValue Float
  minPurchase   Float        @default(0)
  maxDiscount   Float?
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  store   Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([productId])
  @@map("discounts")
}

model Voucher {
  id            Int                 @id @default(autoincrement())
  code          String              @unique
  userId        Int
  productId     Int?
  name          String
  discountType  DiscountType
  discountValue Float
  maxDiscount   Float?
  minPurchase   Float               @default(0) // minimal pembelanjaan untuk pakai voucher
  applicableTo  VoucherApplicableTo @default(ALL_PRODUCTS)
  source        VoucherSource       @default(PROMO) // asal voucher: referral, reward, promo, dll
  expiredAt     DateTime
  used          Boolean             @default(false)
  usedAt        DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
  orders  Order[]

  @@index([userId])
  @@index([code])
  @@map("vouchers")
}

model ReferralCode {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique // satu user hanya punya satu kode
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User            @relation("ReferralCodeOwner", fields: [userId], references: [id], onDelete: Cascade)
  usages ReferralUsage[]

  @@map("referral_codes")
}

model ReferralUsage {
  id             Int      @id @default(autoincrement())
  referralCodeId Int
  usedByUserId   Int      @unique // satu user hanya bisa pakai 1 kode referral
  createdAt      DateTime @default(now())

  referralCode ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)
  usedBy       User         @relation("ReferralUsageUser", fields: [usedByUserId], references: [id], onDelete: Cascade)

  @@index([referralCodeId])
  @@map("referral_usages")
}

model VerificationToken {
  id      Int      @id @default(autoincrement())
  email   String
  token   String   @unique
  expires DateTime
  used    Boolean  @default(false) // verifikasi hanya boleh dilakukan sekali

  @@unique([email, token])
  @@map("verification_tokens")
}

model ResetPasswordToken {
  id      Int      @id @default(autoincrement())
  email   String
  token   String   @unique
  expires DateTime
  used    Boolean  @default(false) // reset hanya boleh dilakukan sekali per request

  @@unique([email, token])
  @@map("reset_password_tokens")
}

model Banner {
  id        Int      @id @default(autoincrement())
  title     String
  imageUrl  String
  linkUrl   String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0) // urutan tampil di carousel
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banners")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}
