// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  SUPER_ADMIN
  STORE_ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  WAITING_CONFIRMATION
  PROCESSING
  SHIPPED
  CONFIRMED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  NOMINAL
  BUY_ONE_GET_ONE
}

enum VoucherApplicableTo {
  ALL_PRODUCTS
  SPECIFIC_PRODUCT
  SHIPPING
}

enum VoucherSource {
  REFERRAL
  MIN_PURCHASE_REWARD
  PROMO
  FREE_SHIPPING_REWARD
}

enum StockJournalType {
  IN
  OUT
  ADJUSTMENT
  ORDER
  CANCEL_RETURN
  MUTATION_IN
  MUTATION_OUT
}

enum MutationStatus {
  PENDING
  APPROVED
  IN_TRANSIT
  COMPLETED
  REJECTED
}

enum PaymentMethod {
  MANUAL_TRANSFER
  PAYMENT_GATEWAY
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id             Int      @id @default(autoincrement())
  name           String
  username       String?  @unique
  email          String   @unique
  password       String?
  phone          String?
  profilePicture String?  @map("profile_picture")
  role           Role     @default(CUSTOMER)
  emailVerified  Boolean  @default(false) @map("email_verified")
  authProvider   String?  @default("CREDENTIALS") @map("auth_provider")
  authProviderId String?  @map("auth_provider_id")
  storeId        Int?     @map("store_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  store              Store?          @relation("StoreAdmin", fields: [storeId], references: [id])
  addresses          UserAddress[]
  orders             Order[]
  cart               Cart?
  vouchers           Voucher[]
  referralCode       ReferralCode?   @relation("ReferralCodeOwner")
  referralUsages     ReferralUsage?  @relation("ReferralUsageUser")
  stockJournals      StockJournal[]
  requestedMutations StockMutation[] @relation("MutationRequester")
  approvedMutations  StockMutation[] @relation("MutationApprover")
  rejectedMutations  StockMutation[] @relation("MutationRejecter")
  receivedMutations  StockMutation[] @relation("MutationReceiver")
  refreshTokens      RefreshToken[]
  shippingCaches     UserShippingCache[]

  @@map("users")
}

model Store {
  id            Int      @id @default(autoincrement())
  name          String
  slug          String   @unique
  description   String?
  image         String?
  latitude      Float
  longitude     Float
  address       String
  city          String
  cityId        String?  @map("city_id") // untuk integrasi API pengiriman (RajaOngkir)
  province      String
  provinceId    String?  @map("province_id") // untuk integrasi API pengiriman (RajaOngkir)
  postalCode    String?  @map("postal_code")
  phone         String?
  serviceRadius Float    @default(50) @map("service_radius") // dalam KM
  status        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  admins               User[]          @relation("StoreAdmin")
  stocks               Stock[]
  orders               Order[]
  carts                Cart[]
  discounts            Discount[]
  sourceMutations      StockMutation[] @relation("MutationSource")
  destinationMutations StockMutation[] @relation("MutationDestination")
  shippingCaches       UserShippingCache[]

  @@map("stores")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  icon        String?
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String   @unique // tidak boleh ada produk dengan nama yang sama
  slug        String   @unique
  description String?
  categoryId  Int      @map("category_id")
  basePrice   Float    @map("base_price")
  weight      Float    @default(0) // dalam gram, untuk kalkulasi ongkir
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category       Category        @relation(fields: [categoryId], references: [id])
  images         ProductImage[]
  stocks         Stock[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  discounts      Discount[]
  vouchers       Voucher[]
  stockMutations StockMutation[]

  @@index([categoryId])
  @@map("products")
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  imageUrl  String   @map("image_url")
  isPrimary Boolean  @default(false) @map("is_primary")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  storeId   Int?     @map("store_id") // cart terikat ke toko terdekat user
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store?     @relation(fields: [storeId], references: [id])
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int      @map("cart_id")
  productId Int      @map("product_id")
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

model Stock {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  storeId   Int      @map("store_id")
  quantity  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product  Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  store    Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  journals StockJournal[]

  @@unique([productId, storeId])
  @@index([storeId])
  @@map("stocks")
}

// Jurnal perubahan stok — setiap perubahan stok HARUS melalui jurnal
model StockJournal {
  id              Int              @id @default(autoincrement())
  stockId         Int              @map("stock_id")
  orderId         Int?             @map("order_id") // nullable, hanya diisi jika terkait order
  stockMutationId Int?             @map("stock_mutation_id") // nullable, hanya diisi jika terkait mutasi stok
  quantityChange  Int              @map("quantity_change") // positif = penambahan, negatif = pengurangan
  quantityBefore  Int              @map("quantity_before")
  quantityAfter   Int              @map("quantity_after")
  type            StockJournalType
  description     String?
  productSnapshot Json?            @map("product_snapshot")
  storeSnapshot   Json?            @map("store_snapshot")
  notes           String?
  createdBy       Int              @map("created_by") // user (admin) yang membuat perubahan
  createdAt       DateTime         @default(now()) @map("created_at")

  stock         Stock          @relation(fields: [stockId], references: [id], onDelete: Cascade)
  order         Order?         @relation(fields: [orderId], references: [id])
  stockMutation StockMutation? @relation(fields: [stockMutationId], references: [id])
  creator       User           @relation(fields: [createdBy], references: [id])

  @@index([stockId])
  @@index([orderId])
  @@index([stockMutationId])
  @@index([createdAt])
  @@map("stock_journals")
}

// Mutasi stok antar gudang/toko
model StockMutation {
  id                 Int            @id @default(autoincrement())
  orderId            Int?           @map("order_id")
  sourceStoreId      Int            @map("source_store_id")
  destinationStoreId Int            @map("destination_store_id")
  productId          Int            @map("product_id")
  quantity           Int
  status             MutationStatus @default(PENDING)
  requestedBy        Int            @map("requested_by")
  approvedBy         Int?           @map("approved_by")
  rejectedBy         Int?           @map("rejected_by")
  receivedBy         Int?           @map("received_by")
  notes              String?
  approvedAt         DateTime?      @map("approved_at")
  rejectedAt         DateTime?      @map("rejected_at")
  sentAt             DateTime?      @map("sent_at")
  receivedAt         DateTime?      @map("received_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  order            Order?         @relation(fields: [orderId], references: [id])
  sourceStore      Store          @relation("MutationSource", fields: [sourceStoreId], references: [id])
  destinationStore Store          @relation("MutationDestination", fields: [destinationStoreId], references: [id])
  product          Product        @relation(fields: [productId], references: [id])
  requester        User           @relation("MutationRequester", fields: [requestedBy], references: [id])
  approver         User?          @relation("MutationApprover", fields: [approvedBy], references: [id])
  rejecter         User?          @relation("MutationRejecter", fields: [rejectedBy], references: [id])
  receiver         User?          @relation("MutationReceiver", fields: [receivedBy], references: [id])
  stockJournals    StockJournal[]

  @@index([orderId])
  @@index([sourceStoreId])
  @@index([destinationStoreId])
  @@index([productId])
  @@index([status])
  @@map("stock_mutations")
}



model UserAddress {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  recipientName String   @map("recipient_name")
  phone         String
  address       String
  city          String
  cityId        String?  @map("city_id") // untuk integrasi API pengiriman (RajaOngkir)
  province      String
  provinceId    String?  @map("province_id") // untuk integrasi API pengiriman (RajaOngkir)
  district      String? // kecamatan
  postalCode    String?  @map("postal_code")
  latitude      Float?
  longitude     Float?
  isPrimary     Boolean  @default(false) @map("is_primary")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]
  shippingCaches UserShippingCache[]

  @@index([userId])
  @@map("user_addresses")
}

model Order {
  id                 Int           @id @default(autoincrement())
  orderNumber        String        @unique @map("order_number") // nomor order yang mudah dibaca, untuk pencarian
  userId             Int           @map("user_id")
  storeId            Int           @map("store_id")
  addressId          Int           @map("address_id") // alamat pengiriman yang dipilih saat checkout
  status             OrderStatus   @default(PENDING_PAYMENT)
  totalProductAmount Float         @default(0) @map("total_product_amount") // subtotal produk sebelum diskon & ongkir
  totalAmount        Float         @map("total_amount") // total akhir yang harus dibayar 
  shippingCost       Float         @default(0) @map("shipping_cost")
  discountAmount     Float         @default(0) @map("discount_amount") // orderitem diskon dipindahkan ke order
  shippingMethod     String?       @map("shipping_method") // nama kurir (JNE, TIKI, dll)
  shippingService    String?       @map("shipping_service") // tipe layanan (REG, YES, dll)
  voucherId          Int?          @map("voucher_id")
  paymentMethod      PaymentMethod @default(MANUAL_TRANSFER) @map("payment_method")
  paymentProof       String?       @map("payment_proof")
  paymentGatewayId   String?       @map("payment_gateway_id") // referensi transaksi payment gateway
  paymentDeadline    DateTime?     @map("payment_deadline") // batas waktu upload bukti bayar (~1 jam)
  shippedAt          DateTime?     @map("shipped_at") // waktu pesanan dikirim (untuk hitung auto-confirm)
  confirmedAt        DateTime?     @map("confirmed_at") // waktu pesanan dikonfirmasi user
  cancelledAt        DateTime?     @map("cancelled_at")
  cancelReason       String?       @map("cancel_reason")
  notes              String?
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id])
  store          Store           @relation(fields: [storeId], references: [id])
  address        UserAddress     @relation(fields: [addressId], references: [id])
  voucher        Voucher?        @relation(fields: [voucherId], references: [id])
  items          OrderItem[]
  stockJournals  StockJournal[]
  stockMutations StockMutation[]

  @@index([userId])
  @@index([storeId])
  @@index([orderNumber])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int      @map("order_id")
  productId   Int      @map("product_id")
  quantity    Int
  priceAtTime Float    @map("price_at_time") // harga produk saat pemesanan
  subtotal    Float // dipindah ke OrderItem sebagai subtotal
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// Diskon yang dikelola per toko — setiap toko bisa atur diskon masing-masing
model Discount {
  id            Int          @id @default(autoincrement())
  storeId       Int          @map("store_id") // diskon dikelola per toko
  productId     Int?         @map("product_id") // nullable: bisa diskon per produk atau tanpa produk tertentu
  name          String
  description   String?
  discountType  DiscountType @map("discount_type")
  discountValue Float        @map("discount_value")
  minPurchase   Float        @default(0) @map("min_purchase")
  maxDiscount   Float?       @map("max_discount")
  startDate     DateTime     @map("start_date")
  endDate       DateTime     @map("end_date")
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  store   Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([productId])
  @@map("discounts")
}

model Voucher {
  id            Int                 @id @default(autoincrement())
  code          String              @unique
  userId        Int                 @map("user_id")
  productId     Int?                @map("product_id")
  name          String
  discountType  DiscountType        @map("discount_type")
  discountValue Float               @map("discount_value")
  maxDiscount   Float?              @map("max_discount")
  minPurchase   Float               @default(0) @map("min_purchase") // minimal pembelanjaan untuk pakai voucher
  applicableTo  VoucherApplicableTo @default(ALL_PRODUCTS) @map("applicable_to")
  source        VoucherSource       @default(PROMO) // asal voucher: referral, reward, promo, dll
  expiredAt     DateTime            @map("expired_at")
  used          Boolean             @default(false)
  usedAt        DateTime?           @map("used_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
  orders  Order[]

  @@index([userId])
  @@index([code])
  @@map("vouchers")
}

model ReferralCode {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id") // satu user hanya punya satu kode
  code      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User            @relation("ReferralCodeOwner", fields: [userId], references: [id], onDelete: Cascade)
  usages ReferralUsage[]

  @@map("referral_codes")
}

model ReferralUsage {
  id             Int      @id @default(autoincrement())
  referralCodeId Int      @map("referral_code_id")
  usedByUserId   Int      @unique @map("used_by_user_id") // satu user hanya bisa pakai 1 kode referral
  createdAt      DateTime @default(now()) @map("created_at")

  referralCode ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)
  usedBy       User         @relation("ReferralUsageUser", fields: [usedByUserId], references: [id], onDelete: Cascade)

  @@index([referralCodeId])
  @@map("referral_usages")
}

model VerificationToken {
  id      Int      @id @default(autoincrement())
  email   String
  token   String   @unique
  expires DateTime
  used    Boolean  @default(false) // verifikasi hanya boleh dilakukan sekali

  @@unique([email, token])
  @@map("verification_tokens")
}

model ResetPasswordToken {
  id      Int      @id @default(autoincrement())
  email   String
  token   String   @unique
  expires DateTime
  used    Boolean  @default(false) // reset hanya boleh dilakukan sekali per request

  @@unique([email, token])
  @@map("reset_password_tokens")
}

model Banner {
  id        Int      @id @default(autoincrement())
  title     String
  imageUrl  String   @map("image_url")
  linkUrl   String?  @map("link_url")
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order") // urutan tampil di carousel
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("banners")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model UserShippingCache {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  addressId    Int      @map("address_id")
  storeId      Int      @map("store_id")
  weight       Int      // berat dalam gram untuk API RajaOngkir
  courier      String   // misal: 'jne', 'pos', 'tiki'
  results      Json     // Array dari tipe layanan kurir
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  address UserAddress @relation(fields: [addressId], references: [id], onDelete: Cascade)
  store   Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, addressId, storeId, weight, courier])
  @@index([userId])
  @@index([addressId])
  @@index([storeId])
  @@map("user_shipping_caches")
}
