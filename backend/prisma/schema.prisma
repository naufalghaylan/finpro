// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  USER
  SUPER_ADMIN
  STORE_ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  WAITING_CONFIRMATION
  PROCESSING
  SHIPPED
  CONFIRMED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  NOMINAL
  BUY_ONE_GET_ONE
  FREE_SHIPPING
}

enum VoucherApplicableTo {
  ALL_PRODUCTS
  SPECIFIC_PRODUCT
  SHIPPING
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                Int           @id @default(autoincrement())
  name              String
  email             String        @unique
  password          String?
  phone             String?
  profilePicture    String?
  role              Role          @default(USER)
  emailVerified     Boolean       @default(false)
  storeId           Int?
  referralCode      String?       @unique
  referredBy        Int?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  store             Store?        @relation("StoreAdmin", fields: [storeId], references: [id])
  addresses         UserAddress[]
  orders            Order[]
  vouchers          Voucher[]
  referrals         User[]        @relation("Referral")
  referredByUser    User?         @relation("Referral", fields: [referredBy], references: [id])

  @@map("users")
}

model Store {
  id                Int           @id @default(autoincrement())
  name              String
  slug              String        @unique
  description       String?
  image             String?
  latitude          Float
  longitude         Float
  address           String
  city              String
  province          String
  postalCode        String?
  phone             String?
  serviceRadius     Float         @default(50) // dalam KM
  status            Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  admins            User[]        @relation("StoreAdmin")
  stocks            Stock[]
  orders            Order[]

  @@map("stores")
}

model Category {
  id                Int           @id @default(autoincrement())
  name              String        @unique
  slug              String        @unique
  icon              String?
  description       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  products          Product[]

  @@map("categories")
}

model Product {
  id                Int           @id @default(autoincrement())
  name              String
  slug              String        @unique
  description       String?
  image             String?
  categoryId        Int
  basePrice         Float
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  category          Category      @relation(fields: [categoryId], references: [id])
  stocks            Stock[]
  orderItems        OrderItem[]
  discounts         Discount[]
  vouchers          Voucher[]

  @@index([categoryId])
  @@map("products")
}

model Stock {
  id                Int           @id @default(autoincrement())
  productId         Int
  storeId           Int
  quantity          Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  product           Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  store             Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([productId, storeId])
  @@index([storeId])
  @@map("stocks")
}

model UserAddress {
  id                Int           @id @default(autoincrement())
  userId            Int
  recipientName     String
  phone             String
  address           String
  city              String
  province          String
  postalCode        String?
  latitude          Float?
  longitude         Float?
  isPrimary         Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_addresses")
}

model Order {
  id                Int           @id @default(autoincrement())
  userId            Int
  storeId           Int
  status            OrderStatus   @default(PENDING_PAYMENT)
  totalAmount       Float
  shippingCost      Float         @default(0)
  discountAmount    Float         @default(0)
  voucherId         Int?
  paymentProof      String?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user              User          @relation(fields: [userId], references: [id])
  store             Store         @relation(fields: [storeId], references: [id])
  voucher           Voucher?      @relation(fields: [voucherId], references: [id])
  items             OrderItem[]

  @@index([userId])
  @@index([storeId])
  @@map("orders")
}

model OrderItem {
  id                Int           @id @default(autoincrement())
  orderId           Int
  productId         Int
  quantity          Int
  priceAtTime       Float
  discountAmount    Float         @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product       @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Discount {
  id                Int           @id @default(autoincrement())
  productId         Int
  name              String
  description       String?
  discountType      DiscountType
  discountValue     Float
  minPurchase       Float         @default(0)
  maxDiscount       Float?
  startDate         DateTime
  endDate           DateTime
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  product           Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("discounts")
}

model Voucher {
  id                Int           @id @default(autoincrement())
  code              String        @unique
  userId            Int
  productId         Int?
  name              String
  discountType      DiscountType
  discountValue     Float
  maxDiscount       Float?
  applicableTo      VoucherApplicableTo @default(ALL_PRODUCTS)
  expiredAt         DateTime
  used              Boolean       @default(false)
  usedAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  product           Product?      @relation(fields: [productId], references: [id])
  orders            Order[]

  @@index([userId])
  @@index([code])
  @@map("vouchers")
}

model ReferralCode {
  id                Int           @id @default(autoincrement())
  userId            Int
  code              String        @unique
  usedBy            Int?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId])
  @@map("referral_codes")
}
